# Required
OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=            # for an OpenAI-compatible gateway
# LLM_TEMPERATURE=0           # leave empty for models that only allow the default
# DATA_DIR=data
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=6
# MAX_UPLOAD_MB=25
